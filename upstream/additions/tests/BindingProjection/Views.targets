<Project>
  <Target Name="_AndroidReferenceViewInputs">
    <PropertyGroup>
      <_AndroidReferenceFoundation>$(MSBuildThisFileDirectory)Foundation/obj/$(Configuration)/$(TargetFramework)/api.xml.class-parse</_AndroidReferenceFoundation>
      <_AndroidReferenceViewOutput>$(IntermediateOutputPath)views</_AndroidReferenceViewOutput>
      <_AndroidReferenceViewSource>$(_AndroidReferenceViewOutput)/Reference.Local.SettingsView.cs</_AndroidReferenceViewSource>
      <_AndroidReferenceDotnet>$(XamarinAndroidSourcePath)dotnet-local.sh</_AndroidReferenceDotnet>
      <_AndroidReferenceDotnet Condition=" '$(OS)' == 'Windows_NT' ">$(XamarinAndroidSourcePath)dotnet-local.cmd</_AndroidReferenceDotnet>
    </PropertyGroup>
  </Target>
  <Target Name="_AndroidGenerateReferenceViews"
      BeforeTargets="CoreCompile"
      DependsOnTargets="ResolveReferences;_AndroidReferenceViewInputs"
      Inputs="$(MSBuildProjectDirectory)/view.json;$(_AndroidReferenceFoundation);@(ReferencePath);$(MonoAndroidToolsDirectory)/generator.dll;$(MonoAndroidToolsDirectory)/Java.Interop.Tools.Generator.dll"
      Outputs="$(_AndroidReferenceViewSource);$(_AndroidReferenceViewOutput)/native-requirements.json">
    <MakeDir Directories="$(_AndroidReferenceViewOutput)" />
    <WriteLinesToFile File="$(_AndroidReferenceViewOutput)/view.rsp" Overwrite="true"
        Lines="--experimental-semantic-model;--experimental-view-contract=&quot;$(MSBuildProjectDirectory)/view.json&quot;;--csdir=&quot;$(_AndroidReferenceViewOutput)&quot;;@(ReferencePath->'--ref=&quot;%(FullPath)&quot;');&quot;$(_AndroidReferenceFoundation)&quot;" />
    <Exec Command="&quot;$(_AndroidReferenceDotnet)&quot; &quot;$(MonoAndroidToolsDirectory)/generator.dll&quot; @&quot;$(_AndroidReferenceViewOutput)/view.rsp&quot;" />
    <ItemGroup>
      <FileWrites Include="$(_AndroidReferenceViewOutput)\**\*" />
    </ItemGroup>
  </Target>
  <Target Name="_AndroidCollectReferenceViews" BeforeTargets="AssignTargetPaths" DependsOnTargets="_AndroidGenerateReferenceViews">
    <ItemGroup>
      <Compile Include="$(_AndroidReferenceViewSource)" />
      <EmbeddedResource Include="$(_AndroidReferenceViewOutput)/native-requirements.json" LogicalName="Java.Interop.NativeRequirements.json" />
    </ItemGroup>
  </Target>
</Project>
