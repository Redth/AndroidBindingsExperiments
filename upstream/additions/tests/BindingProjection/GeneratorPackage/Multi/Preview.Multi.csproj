<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net10.0</TargetFrameworks>
    <AndroidBindingGenerator>Semantic</AndroidBindingGenerator>
    <GeneratorPackageVersion Condition=" '$(GeneratorPackageVersion)' == '' ">0.1.0-preview.1</GeneratorPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net11.0-android' ">
    <IsBindingProject>true</IsBindingProject>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Android.BindingGenerator.Semantic" Version="$(GeneratorPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0-android' ">
    <AndroidLibrary Include="..\Binding\preview.jar" Bind="true" />
    <AndroidNamespaceReplacement Include="Net.Dot.Android.Packagetest" Replacement="PackagePreview" />
    <TransformFile Include="..\Binding\Metadata.xml" />
    <Compile Include="..\Binding\Additions.cs" />
  </ItemGroup>
</Project>
